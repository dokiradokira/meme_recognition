{
  "name": "meme-recognition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "setup:model": "node scripts/model.mjs",
    "predev": "npm run setup:model",
    "dev": "vite",
