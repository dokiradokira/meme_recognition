    "test:e2e": "playwright test"
  },
  "dependencies": { "@mediapipe/tasks-vision": "0.10.21" },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
